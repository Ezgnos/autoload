<?php
declare(strict_types=1);

abstract class Employee
{
    // Минимальная премия. Типизированные константы (const string ...) появились только в PHP 8.3,
    // поэтому используем обычную константу.
    public const MIN_BONUS = 500;

    private static int $employeeCount = 0;

    public function __construct(
        protected string $name,
        protected float $salary,
    ) {
        self::$employeeCount++;
    }

    abstract public function calculateBonus(): float;

    // Если премия меньше минимальной — возвращается MIN_BONUS
    protected function applyMinBonus(float $bonus): float
    {
        return max($bonus, (float) self::MIN_BONUS);
    }

    public function getTotalPay(): float
    {
        return $this->salary + $this->calculateBonus();
    }

    public function getInfo(): string
    {
        return sprintf(
            '%s (%s): оклад %s руб., премия %s руб.',
            $this->name,
            static::class,
            number_format($this->salary, 2, '.', ' '),
            number_format($this->calculateBonus(), 2, '.', ' ')
        );
    }

    public static function getEmployeeCount(): int
    {
        return self::$employeeCount;
    }
}

<?php
declare(strict_types=1);

class Developer extends Employee
{
    public function __construct(
        string $name,
        float $salary,
        private int $experienceYears,
    ) {
        parent::__construct($name, $salary);
    }

    // 15% оклада + 1000 за каждый год стажа
    public function calculateBonus(): float
    {
        return $this->applyMinBonus($this->salary * 0.15 + 1000 * $this->experienceYears);
    }
}
